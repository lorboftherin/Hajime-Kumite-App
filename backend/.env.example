# Copiar a .env y ajustar. Prefijo HAJIME_.
HAJIME_ENVIRONMENT=dev
# SQLite local (por defecto):
HAJIME_DATABASE_URL=sqlite:///./hajime.db
# SQL Server local (docker compose):
# HAJIME_DATABASE_URL=mssql+pyodbc://sa:Hajime_Dev_2026!@localhost:1433/hajime?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Mínimo 32 caracteres aleatorios en TEST/PROD:
HAJIME_JWT_SECRET=cambiar-en-produccion-por-un-secreto-largo
HAJIME_CORS_ORIGINS=["http://localhost:4200"]
